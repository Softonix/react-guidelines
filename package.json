{
  "name": "react-spa-supabase-starter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preflight": "npm run typecheck && npm run lint && npm run format:check",
    "db:start": "supabase start -x realtime,edge-runtime,imgproxy,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:gen-types": "supabase gen types typescript --schema public > app/shared/api/schema/database.types.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@mantine/core": "^9.8.0",
    "@mantine/dates": "^9.8.0",
    "@mantine/form": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/modals": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.29.7",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "supabase": "^3.0.0",
    "tailwind-preset-mantine": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "type-fest": "^5.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-babel": "^1.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  }
}
