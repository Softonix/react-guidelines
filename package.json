{
  "name": "react-spa-supabase-starter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preflight": "npm run typecheck && npm run lint && npm run format:check",
    "db:start": "supabase start -x realtime,edge-runtime,imgproxy,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:gen-types": "supabase gen types typescript --local --schema public > app/shared/api/schema/database.types.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@mantine/core": "^9.1.1",
    "@mantine/dates": "^9.1.1",
    "@mantine/form": "^9.1.1",
    "@mantine/hooks": "^9.1.1",
    "@mantine/modals": "^9.1.1",
    "@mantine/notifications": "^9.1.1",
    "@react-router/node": "7.15.1",
    "@react-router/serve": "7.15.1",
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/react-query": "^5.100.8",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "isbot": "^5",
    "mantine-form-zod-resolver": "^1.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.15.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@react-router/dev": "7.15.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query-devtools": "^5.100.8",
    "@types/node": "^24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "supabase": "^2.100.0",
    "tailwind-preset-mantine": "^4.0.3",
    "tailwindcss": "^4.2.2",
    "type-fest": "^5.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.3",
    "vite-plugin-babel": "^1.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  }
}
